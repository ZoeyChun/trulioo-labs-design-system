{
  "name": "tds-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for the Trulioo Design System — use TDS tokens, components, and guidelines in any AI tool",
  "main": "src/server.js",
  "bin": {
    "tds-mcp": "src/server.js"
  },
  "files": [
    "src/",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "bundle": "node scripts/bundle-data.js",
    "test": "node test-smoke.js",
    "prepublishOnly": "npm run bundle"
  },
  "keywords": [
    "mcp",
    "design-system",
    "trulioo",
    "tds",
    "ui",
    "components",
    "tokens"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
